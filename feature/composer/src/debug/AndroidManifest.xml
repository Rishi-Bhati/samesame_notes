            android:name="org.samesame.notes.feature.composer.canvas.CanvasDebugActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustNothing" />
    </application>
</manifest>
