<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview (Android 12+) of the quick-capture widget at its default 2 x 2 size: the pad, four quadrant
     buttons around the accent coin, drawn by @drawable/widget_preview_capture. No card behind it, like the widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_gravity="center" android:scaleType="fitCenter"
        android:src="@drawable/widget_preview_capture" android:importantForAccessibility="no" />
</FrameLayout>
