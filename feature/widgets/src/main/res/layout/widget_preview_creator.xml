<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview (Android 12+) of the new-note widget at its default size: five round buttons. -->
<!-- RemoteViews preview: inflated without AppCompat, so android:tint is the attribute that works here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_pv_bg" android:orientation="horizontal" android:padding="6dp"
    android:gravity="center_vertical">
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
                android:background="@drawable/widget_pv_circle_accent" android:padding="11dp"
                android:src="@drawable/ic_oui_keyboard" android:tint="@android:color/white" android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
                android:background="@drawable/widget_pv_circle_tile" android:padding="11dp"
                android:src="@drawable/ic_oui_pen_fountain" android:tint="@color/widget_pv_icon" android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
                android:background="@drawable/widget_pv_circle_tile" android:padding="11dp"
                android:src="@drawable/ic_oui_brush_outline" android:tint="@color/widget_pv_icon" android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
                android:background="@drawable/widget_pv_circle_tile" android:padding="11dp"
                android:src="@drawable/ic_oui_image_outline" android:tint="@color/widget_pv_icon" android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
                android:background="@drawable/widget_pv_circle_tile" android:padding="11dp"
                android:src="@drawable/ic_oui_voice" android:tint="@color/widget_pv_icon" android:importantForAccessibility="no" />
        </FrameLayout>
</LinearLayout>
