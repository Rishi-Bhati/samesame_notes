<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The capture sheet's dictation button looks for the system speech recogniser (package visibility, Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application>
        <receiver
            android:name=".NoteCreatorWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_creator_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_creator_info" />
        </receiver>

        <receiver
            android:name=".SingleNoteWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_single_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_single_info" />
        </receiver>

        <receiver
            android:name=".NoteListWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_list_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_list_info" />
        </receiver>

        <receiver
            android:name=".NoteGridWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_grid_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_grid_info" />
        </receiver>

        <receiver
            android:name=".QuickCaptureWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_capture_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_capture_info" />
        </receiver>

        <!-- Quick capture sheet over the home screen; only the widget's own pending intents start it. -->
        <activity
            android:name=".CaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SameSame.CaptureSheet"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible" />

        <!-- Configure screens: started by the launcher when a widget is added (or reconfigured). -->
        <activity
            android:name=".NotePickerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CreatorSettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".NoteListConfigureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Creator buttons: only the widget's own pending intents start it. -->
        <activity
            android:name=".WidgetCreateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
