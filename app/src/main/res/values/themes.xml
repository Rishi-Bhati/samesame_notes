<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only sets the window before the first frame. -->
    <style name="Theme.SameSame" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/samesame_window_background</item>
    </style>
    <!-- The share/Open-with receiver and the file viewers: a transparent window the screen draws its sheet or page over. -->
    <style name="Theme.SameSame.Receive" parent="Theme.SameSame">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
