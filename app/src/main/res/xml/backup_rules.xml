<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8-11 (Auto Backup ignores data_extraction_rules there): the same set as data_extraction_rules.xml, and only
  into an end-to-end encrypted backup (requireFlags, honoured from Android 9). Settings, search history and every
  other file stay out.
-->
<full-backup-content>
    <include domain="database" path="." requireFlags="clientSideEncryption" />
    <include domain="file" path="notes/" requireFlags="clientSideEncryption" />
</full-backup-content>
