# Clean-room boundary: third-party reference material stays on this machine
# and is never committed.
research/
parked/

# Device captures and reference imagery. Text notes under docs/ stay tracked; the
# screenshots, videos, APKs and traces below may contain third-party UI or personal content.
docs/**/*.png
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.webp
docs/**/*.gif
docs/**/*.mp4
docs/**/*.mov
docs/**/*.apk
docs/**/*.aab
docs/**/*.zip
docs/**/*.pftrace
docs/**/*.log

# Only the app code is published: project docs, agent notes, device captures, security reports
# and the icon-tracing workspace stay local.
docs/
CLAUDE.md

# Release signing material (never commit)
signing/
