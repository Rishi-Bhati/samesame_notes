<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog window enter: rises 100 px over 300 ms (sine-out) while fading in over 150 ms. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <translate
        android:duration="300"
        android:fromYDelta="100"
        android:interpolator="@interpolator/samesame_sine_out_80"
        android:toYDelta="0" />
    <alpha
        android:duration="150"
        android:fromAlpha="0"
        android:interpolator="@interpolator/samesame_sine_out_80"
        android:toAlpha="1" />
</set>
